# STEP 1: Clone Real-ESRGAN and install dependencies
!git clone https://github.com/xinntao/Real-ESRGAN
%cd Real-ESRGAN
!pip install -r requirements.txt
!python setup.py develop

# STEP 2: Download pretrained model (x4 upscale)
!wget https://github.com/xinntao/Real-ESRGAN/releases/download/v0.1.0/RealESRGAN_x4plus.pth -P weights

# STEP 3: Upload your video
from google.colab import files
uploaded = files.upload()

# STEP 4: Extract frames from video
!mkdir frames
!ffmpeg -i input.mp4 frames/frame_%04d.png

# STEP 5: Upscale frames to 8K using Real-ESRGAN
!mkdir results
!python inference_realesrgan.py \
    -n RealESRGAN_x4plus \
    -i frames \
    -o results \
    --outscale 8 \
    --face_enhance

# STEP 6: Rebuild video from upscaled frames
!ffmpeg -framerate 30 -i results/frame_%04d_out.png -c:v libx264 -pix_fmt yuv420p output_upscaled_8k.mp4

# STEP 7: Download final video
from google.colab import files
files.download('output_upscaled_8k.mp4')
